FROM docker.io/library/python:3.12.14-slim

COPY llm-security-control-plane/guided-labs/h01-bedrock-gateway/requirements.txt /tmp/gateway.txt
COPY llm-security-control-plane/guided-evidence-verifier/requirements.txt /tmp/verifier.txt
RUN pip install --no-cache-dir -r /tmp/gateway.txt -r /tmp/verifier.txt PyYAML==6.0.3

ENV PYTHONDONTWRITEBYTECODE=1
WORKDIR /workspace
USER 65532:65532
ENTRYPOINT ["python", "-B", "-m", "unittest"]
