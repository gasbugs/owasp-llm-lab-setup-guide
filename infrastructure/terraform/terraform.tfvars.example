################################################################################
# 수강생이 확인하거나 변경할 값
#   cp terraform.tfvars.example terraform.tfvars
################################################################################

aws_profile = "owasp-llm"
region      = "us-east-1"

course_id = "owasp-llm-2026"

# false는 SSM 접속 후 수동 설치, true는 최초 부팅 때 자동 설치.
enable_user_data_bootstrap = false

# 본인 공인 IPv4 뒤에 /32를 붙인다. 0.0.0.0/0은 허용하지 않는다.
allowed_ingress_cidr = "203.0.113.10/32"

# 기본값: g6.xlarge, 100GB. AMI·commit 고정은 ../../docs/TERRAFORM-ADVANCED-OPTIONS.md 참고.
