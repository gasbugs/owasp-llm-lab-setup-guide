#!/bin/bash
# Restore allowlisted OWASP LLM lab runtime state without touching learner files.
#
# Usage:
#   reset-lab llm08-rag
#   reset-lab llm05
#   reset-lab llm06
#   reset-lab llmgoat
#   reset-lab llm10

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: reset-lab <lab-id>

Allowlisted lab IDs:
  llm01    LLM01 editable source and direct-input process memory
  llm02    LLM02 editable source and 2일차 process memory
  llm04    LLM04 editable source and in-memory RAG corpus
  llm08-rag 2일차 in-memory RAG corpus
  llm05    3일차 in-memory RAG corpus
  llm06    Agent ANIMALS and DELETED_LOG memory
  llm08    LLM08 editable source and 4일차 process memory
  llm09    LLM09 editable source and 4일차 process memory
  llmgoat  LLMGoat mutable challenge memory
  llm10    5일차 app tasks and the shared Ollama request queue

This command recreates or restarts only allowlisted Compose services, then
reads readiness URLs.
It does not modify learner work, evidence, Capstone source, models, or caches.
EOF
}

if [ "$(id -u)" -eq 0 ]; then
  if ! id ubuntu >/dev/null 2>&1; then
    echo "ERROR: ubuntu learner account is unavailable" >&2
    exit 3
  fi
  ubuntu_uid=$(id -u ubuntu)
  exec runuser -u ubuntu -- env \
    XDG_RUNTIME_DIR="/run/user/$ubuntu_uid" \
    DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$ubuntu_uid/bus" \
    "$0" "$@"
fi

if [ "$#" -ne 1 ]; then
  usage >&2
  exit 2
fi

case "$1" in
  -h|--help|help)
    usage
    exit 0
    ;;
esac

for command_name in docker curl; do
  if ! command -v "$command_name" >/dev/null 2>&1; then
    echo "ERROR: required command is unavailable: $command_name" >&2
    exit 3
  fi
done

uid=$(id -u)
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$uid}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}"
RECREATE_EDITABLE_LAB="${RECREATE_EDITABLE_LAB:-$HOME/.local/bin/recreate-editable-lab}"

RESET_LAB_READY_ATTEMPTS="${RESET_LAB_READY_ATTEMPTS:-60}"
RESET_LAB_READY_SLEEP_SECONDS="${RESET_LAB_READY_SLEEP_SECONDS:-2}"

case "$RESET_LAB_READY_ATTEMPTS" in
  ''|*[!0-9]*)
    echo "ERROR: RESET_LAB_READY_ATTEMPTS must be a positive integer" >&2
    exit 2
    ;;
esac
case "$RESET_LAB_READY_SLEEP_SECONDS" in
  ''|*[!0-9]*)
    echo "ERROR: RESET_LAB_READY_SLEEP_SECONDS must be a positive integer" >&2
    exit 2
    ;;
esac
if [ "$RESET_LAB_READY_ATTEMPTS" -lt 1 ] || \
   [ "$RESET_LAB_READY_SLEEP_SECONDS" -lt 1 ]; then
  echo "ERROR: readiness bounds must be positive integers" >&2
  exit 2
fi

wait_for_raw_readiness() {
  label="$1"
  url="$2"
  attempt=1
  while [ "$attempt" -le "$RESET_LAB_READY_ATTEMPTS" ]; do
    if raw_body=$(curl --noproxy '*' -fsS --max-time 5 "$url" 2>/dev/null); then
      if [ -n "$raw_body" ]; then
        printf '%s_READY_URL=%s\n' "$label" "$url"
        printf '%s\n' "$raw_body"
        return 0
      fi
    fi
    if [ "$attempt" -lt "$RESET_LAB_READY_ATTEMPTS" ]; then
      sleep "$RESET_LAB_READY_SLEEP_SECONDS"
    fi
    attempt=$((attempt + 1))
  done
  echo "ERROR: readiness timeout for $label at $url" >&2
  return 3
}

restart_one() {
  container="$1"
  label="$2"
  url="$3"
  printf 'RESET_CONTAINER=%s\n' "$container"
  docker restart "$container"
  wait_for_raw_readiness "$label" "$url"
}

recreate_one() {
  container="$1"
  label="$2"
  url="$3"
  if [ ! -x "$RECREATE_EDITABLE_LAB" ]; then
    echo "ERROR: editable container runner is unavailable: $RECREATE_EDITABLE_LAB" >&2
    return 3
  fi
  printf 'RESET_CONTAINER=%s\n' "$container"
  "$RECREATE_EDITABLE_LAB" "$container"
  wait_for_raw_readiness "$label" "$url"
}

lab_id="$1"
case "$lab_id" in
  llm01)
    recreate_one \
      lab-prompt-rag \
      LLM01 \
      http://127.0.0.1/prompt-rag/healthz
    ;;
  llm02|llm08-rag)
    recreate_one \
      lab-data-rag \
      LLM02_LLM08_RAG \
      http://127.0.0.1/data-rag/healthz
    ;;
  llm04)
    recreate_one \
      lab-llm04-rag \
      LLM04 \
      http://127.0.0.1/llm04-rag/healthz
    ;;
  llm05)
    recreate_one \
      lab-output-rag \
      LLM05 \
      http://127.0.0.1/output-rag/healthz
    ;;
  llm06)
    recreate_one \
      lab-vuln-agent \
      LLM06 \
      http://127.0.0.1/vuln-agent/healthz
    ;;
  llm08|llm09)
    recreate_one \
      lab-knowledge-rag \
      LLM08_LLM09 \
      http://127.0.0.1/knowledge-rag/healthz
    ;;
  llmgoat)
    restart_one \
      lab-llmgoat \
      LLMGOAT \
      http://127.0.0.1/llmgoat/api/model_status
    ;;
  llm10)
    # A timed-out client can leave both an awaiting uvicorn task and queued
    # Ollama generation. Cancel the app task first, clear the backend queue,
    # then reconnect a fresh 5일차 app process to the ready backend.
    recreate_one \
      lab-resource-rag \
      LLM10_APP \
      http://127.0.0.1/resource-rag/healthz
    printf 'RESET_CONTAINER=%s\n' lab-ollama
    docker restart lab-ollama
    wait_for_raw_readiness OLLAMA http://127.0.0.1/ollama/api/tags
    recreate_one \
      lab-resource-rag \
      LLM10 \
      http://127.0.0.1/resource-rag/healthz
    ;;
  *)
    echo "ERROR: lab-id is not allowlisted: $lab_id" >&2
    usage >&2
    exit 2
    ;;
esac
