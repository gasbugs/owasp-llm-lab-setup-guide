FROM docker.io/library/python:3.12.14-slim
ENV PIP_NO_CACHE_DIR=1 PYTHONUNBUFFERED=1
RUN python -m pip install fastapi==0.116.1 httpx==0.28.1 uvicorn==0.52.0
WORKDIR /app
COPY --chmod=0444 guided-contracts/p12.json /app/contracts/p12.json
COPY --chmod=0444 guided-labs/h12-application-pipeline/Containerfile /app/learner/Containerfile
COPY --chmod=0444 guided-labs/h12-application-pipeline/pipeline.py /app/learner/pipeline.py
COPY --chmod=0444 guided-labs/h12-application-pipeline/service_client.py guided-labs/h12-application-pipeline/execution.py /app/learner/
COPY --chmod=0444 guided-labs/h12-application-pipeline/workflow.py /app/learner/workflow.py
COPY --chmod=0444 guided-labs/h12-application-pipeline/run_server.py /app/learner/run_server.py
RUN install -d -o 65532 -g 65532 -m 0700 /state && chmod 0555 /app/learner /app/contracts
USER 65532:65532
EXPOSE 8000
CMD ["uvicorn", "run_server:configured_app", "--factory", "--app-dir", "/app/learner", "--host", "0.0.0.0", "--port", "8000", "--log-level", "warning"]
