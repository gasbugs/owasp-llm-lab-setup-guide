FROM docker.io/library/python:3.12.11-slim-bookworm
ARG PYRIT_VERSION=1.0.1
ENV PIP_NO_CACHE_DIR=1 PYTHONUNBUFFERED=1 HOME=/state
RUN python -m pip install "pyrit==${PYRIT_VERSION}" fastapi==0.133.0 uvicorn==0.52.0
WORKDIR /work
COPY --chmod=0444 guided-labs/h15-pyrit/attack.py /work/attack.py
COPY --chmod=0555 guided-labs/h15-pyrit/server.py /work/server.py
RUN install -d -m 0700 -o 65532 -g 65532 /state
USER 65532:65532
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000", "--log-level", "warning"]
