FROM docker.io/library/python:3.12.14-slim
ENV PIP_NO_CACHE_DIR=1 PYTHONUNBUFFERED=1
RUN python -m pip install fastapi==0.116.1 uvicorn==0.52.0
WORKDIR /app
COPY --chmod=0444 guided-labs/h12-protected-services/context_server.py guided-labs/h12-protected-services/context_store.py /app/
RUN install -d -o 65532 -g 65532 -m 0700 /state
USER 65532:65532
EXPOSE 8000
CMD ["uvicorn", "context_server:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--log-level", "warning"]
