FROM docker.io/library/python:3.12.14-slim

ENV NEMO_GUARDRAILS_NO_USAGE_STATS=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1 \
    XDG_CACHE_HOME=/tmp/nemo-cache

RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc g++ python3-dev \
    && python -m pip install \
      fastapi==0.116.1 \
      fastembed==0.7.3 \
      nemoguardrails==0.22.0 \
      uvicorn==0.52.0 \
    && apt-get purge -y --auto-remove gcc g++ python3-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --chmod=0444 guided-labs/h12-protected-services/nemo.py guided-labs/h12-protected-services/retrieval.py guided-labs/h12-protected-services/gateway_model.py guided-labs/h12-protected-services/nemo_server.py /app/
RUN install -d -o 65532 -g 65532 -m 0700 /state

USER 65532:65532
EXPOSE 8000
CMD ["uvicorn", "nemo_server:create_service", "--factory", "--host", "0.0.0.0", "--port", "8000", "--log-level", "warning"]
