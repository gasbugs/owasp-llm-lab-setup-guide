FROM docker.io/library/python:3.12.14-slim

ENV PIP_NO_CACHE_DIR=1 PYTHONUNBUFFERED=1
COPY guided-labs/h01-bedrock-gateway/requirements.txt /tmp/requirements.txt
RUN python -m pip install --requirement /tmp/requirements.txt

WORKDIR /app
COPY --chmod=0444 guided-labs/h01-bedrock-gateway/server.py /app/server.py
COPY --chmod=0444 guided-labs/h01-bedrock-gateway/learner.py /app/learner.py
COPY --chmod=0444 guided-labs/h01-bedrock-gateway/provider.py /app/provider.py

USER 65532:65532
EXPOSE 8000
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000", "--log-level", "warning"]
