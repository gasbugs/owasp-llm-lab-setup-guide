FROM docker.io/library/python:3.12.14-slim
ENV PIP_NO_CACHE_DIR=1 PYTHONUNBUFFERED=1
RUN python -m pip install fastapi==0.116.1 uvicorn==0.52.0
WORKDIR /app
COPY --chmod=0555 guided-labs/h13-promptfoo-target/server.py /app/server.py
USER 65532:65532
EXPOSE 8000
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000", "--log-level", "warning"]
