FROM docker.io/library/python:3.12.14-slim

ENV PIP_NO_CACHE_DIR=1 PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY guided-labs/h21-agent-policy/requirements.txt /tmp/requirements.txt
RUN python -m pip install --requirement /tmp/requirements.txt

WORKDIR /app
COPY --chmod=0444 guided-labs/h21-agent-policy/policy.py /app/policy.py
COPY --chmod=0444 guided-labs/h21-agent-policy/host.py /app/host.py
COPY --chmod=0444 guided-labs/h21-agent-policy/mcp_server.py /app/mcp_server.py
COPY --chmod=0444 guided-labs/h21-agent-policy/provider.py /app/provider.py

USER 65532:65532
EXPOSE 8000
