FROM docker.io/library/python:3.12.14-slim

ENV PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1 \
    XDG_CACHE_HOME=/tmp/presidio-cache

COPY guided-labs/h09-presidio-redaction/requirements.txt /tmp/requirements.txt
RUN python -m pip install --requirement /tmp/requirements.txt \
    && python -m pip install \
      'https://github.com/explosion/spacy-models/releases/download/en_core_web_sm-3.8.0/en_core_web_sm-3.8.0-py3-none-any.whl' \
    && python -c "import tldextract; tldextract.extract('example.com')"

WORKDIR /app/learner
COPY --chmod=0444 guided-labs/h09-presidio-redaction/Containerfile /app/learner/Containerfile
COPY --chmod=0444 guided-labs/h09-presidio-redaction/requirements.txt /app/learner/requirements.txt
COPY --chmod=0444 guided-labs/h09-presidio-redaction/policy.py /app/learner/policy.py
COPY --chmod=0444 guided-labs/h09-presidio-redaction/server.py /app/learner/server.py
RUN install -d -o 65532 -g 65532 -m 0700 /state \
    && chmod -R a+rwX /tmp/presidio-cache

USER 65532:65532
EXPOSE 8000
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000", "--log-level", "warning"]
