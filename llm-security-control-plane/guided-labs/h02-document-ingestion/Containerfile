FROM docker.io/library/python:3.12.14-slim

ENV PIP_NO_CACHE_DIR=1 PYTHONUNBUFFERED=1
COPY guided-labs/h02-document-ingestion/requirements.txt /tmp/requirements.txt
RUN python -m pip install --requirement /tmp/requirements.txt

WORKDIR /app
COPY --chmod=0444 guided-labs/h02-document-ingestion/learner.py guided-labs/h02-document-ingestion/execution.py guided-labs/h02-document-ingestion/service_client.py guided-labs/h02-document-ingestion/workflow.py guided-labs/h02-document-ingestion/run_server.py guided-labs/h02-document-ingestion/cases.py /app/
COPY --chmod=0444 guided-labs/h02-document-ingestion/requirements.txt guided-labs/h02-document-ingestion/Containerfile /app/

USER 65532:65532
EXPOSE 8000
CMD ["uvicorn", "run_server:configured_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--log-level", "warning"]
