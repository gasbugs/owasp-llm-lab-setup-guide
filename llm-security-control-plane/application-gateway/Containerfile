# 검증한 Python patch version을 읽기 쉬운 tag로 고정한다.
FROM docker.io/library/python:3.12.14-slim

# pip cache를 남기지 않고 애플리케이션 로그를 즉시 출력한다.
ENV PIP_NO_CACHE_DIR=1 PYTHONUNBUFFERED=1

# 인증, 정책 집행, 내부 서비스 호출과 HTTP API에 필요한 의존성만 설치한다.
COPY application-gateway/requirements.txt /tmp/requirements.txt
RUN python -m pip install --requirement /tmp/requirements.txt

WORKDIR /app
# 서버 소유 사용자·정책 파일과 실행 코드를 읽기 전용으로 복사한다.
# 요청 본문이 Tenant·역할·승인 상태를 스스로 선언하지 못하게 하는 신뢰 경계다.
RUN install -d -m 0555 /app/policies
COPY --chmod=0444 shared/telemetry.py /app/telemetry.py
COPY --chmod=0444 versions.lock.yaml /app/versions.lock.yaml
COPY --chmod=0444 policies/application-policy.yaml /app/policies/application-policy.yaml
COPY --chmod=0444 policies/application-users.yaml /app/policies/application-users.yaml
COPY --chmod=0444 application-gateway/auth.py /app/auth.py
COPY --chmod=0444 application-gateway/policy.py /app/policy.py
COPY --chmod=0444 application-gateway/server.py /app/server.py
COPY --chmod=0444 application-gateway/index.html /app/index.html
# 런타임 상태만 non-root 프로세스가 쓰도록 전용 디렉터리 권한을 제한한다.
RUN install -d -o 65532 -g 65532 -m 0700 /app/state

# root 권한 없이 실행한다. EXPOSE는 포트를 문서화하며 실제 호스트 공개 범위는 Compose가 결정한다.
USER 65532:65532
EXPOSE 8000
# Application은 외부 요청을 받고 정책·Presidio·NeMo·Bedrock 내부 호출 순서를 조정한다.
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000", "--log-level", "warning"]
