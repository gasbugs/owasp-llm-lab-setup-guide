FROM docker.io/library/python:3.12-slim@sha256:2c941e860699f878900b0edc2403613c234d4b32eda3cc9fa7036991a2a63c4a

ENV PIP_NO_CACHE_DIR=1 PYTHONUNBUFFERED=1

COPY application-gateway/requirements.txt /tmp/requirements.txt
RUN python -m pip install --requirement /tmp/requirements.txt

WORKDIR /app
COPY --chmod=0444 shared/telemetry.py /app/telemetry.py
COPY --chmod=0444 versions.lock.yaml /app/versions.lock.yaml
COPY --chmod=0444 policies/application-policy.yaml /app/policies/application-policy.yaml
COPY --chmod=0444 application-gateway/policy.py /app/policy.py
COPY --chmod=0444 application-gateway/server.py /app/server.py
COPY --chmod=0444 application-gateway/index.html /app/index.html

USER 65532:65532
EXPOSE 8000
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000", "--log-level", "warning"]
