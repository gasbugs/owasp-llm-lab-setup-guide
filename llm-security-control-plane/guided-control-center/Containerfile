FROM docker.io/library/python:3.12.14-slim

ARG APP_VERSION=dev
ENV APP_VERSION=${APP_VERSION} \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY --chmod=0444 guided-control-center/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY --chmod=0444 guided-control-center/server.py guided-control-center/index.html \
    guided-control-center/app.css guided-control-center/app.js ./

USER 65532:65532
EXPOSE 8000
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000"]
