FROM docker.io/library/python:3.12.14-slim

ARG APP_VERSION=dev
ENV APP_VERSION=${APP_VERSION} \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY --chmod=0444 guided-contracts/p01.json /app/p01.json
COPY --chmod=0444 guided-control-center/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY --chmod=0444 guided-control-center/server.py guided-control-center/progress.py guided-control-center/diagnostics.py guided-control-center/index.html \
    guided-control-center/app.css guided-control-center/app.js guided-control-center/experience.json guided-control-center/case-catalog.json ./
COPY guided-control-center/admin-answers/ /app/admin-answers/
RUN chmod 0555 /app/admin-answers && chmod 0444 /app/admin-answers/*
COPY guided-control-center/fonts/IBMPlexMono-SemiBold.woff2 guided-control-center/fonts/LICENSE.txt /app/fonts/
RUN chmod 0755 /app/fonts && chmod 0444 /app/fonts/*
RUN install -d -o 65532 -g 65532 -m 0700 /state

USER 65532:65532
EXPOSE 8000
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000"]
