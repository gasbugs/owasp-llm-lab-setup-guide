FROM docker.io/library/python:3.12.14-slim

ARG APP_VERSION=dev
ENV APP_VERSION=${APP_VERSION} \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY --chmod=0444 guided-contracts/p01.json /app/p01.json
COPY --chmod=0444 guided-control-center/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY --chmod=0444 guided-control-center/server.py guided-control-center/progress.py guided-control-center/diagnostics.py guided-control-center/index.html \
    guided-control-center/app.css guided-control-center/app.js guided-control-center/experience.json guided-control-center/case-catalog.json ./
COPY --chmod=0444 guided-control-center/admin-answers/P00.md guided-control-center/admin-answers/P01.md guided-control-center/admin-answers/P02.md guided-control-center/admin-answers/P03.md guided-control-center/admin-answers/P04.md guided-control-center/admin-answers/P05.md guided-control-center/admin-answers/P06.md guided-control-center/admin-answers/P07.md guided-control-center/admin-answers/P08.md guided-control-center/admin-answers/P09.md guided-control-center/admin-answers/P10.md guided-control-center/admin-answers/P11.md guided-control-center/admin-answers/P12.md guided-control-center/admin-answers/P13.md guided-control-center/admin-answers/P14.md guided-control-center/admin-answers/P15.md guided-control-center/admin-answers/P16.md guided-control-center/admin-answers/P17.md guided-control-center/admin-answers/P18.md guided-control-center/admin-answers/P19.md guided-control-center/admin-answers/P20.md guided-control-center/admin-answers/P21.md guided-control-center/admin-answers/P22.md guided-control-center/admin-answers/P23.md /app/admin-answers/
RUN chmod 0555 /app/admin-answers && chmod 0444 /app/admin-answers/*
COPY guided-control-center/fonts/IBMPlexMono-SemiBold.woff2 guided-control-center/fonts/LICENSE.txt /app/fonts/
RUN chmod 0755 /app/fonts && chmod 0444 /app/fonts/*
RUN install -d -o 65532 -g 65532 -m 0700 /state

USER 65532:65532
EXPOSE 8000
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000"]
