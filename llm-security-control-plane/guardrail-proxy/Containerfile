FROM docker.io/library/python:3.12.14-slim

ENV PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1 \
    NEMO_GUARDRAILS_NO_USAGE_STATS=1 \
    XDG_CACHE_HOME=/tmp/nemo-cache

RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc g++ python3-dev \
    && python -m pip install \
      fastapi==0.116.1 \
      fastembed==0.7.3 \
      httpx==0.28.1 \
      nemoguardrails==0.24.1 \
      uvicorn==0.52.0 \
    && apt-get purge -y --auto-remove gcc g++ python3-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --chmod=0444 guardrail-proxy/server.py guardrail-proxy/gateway_model.py guardrail-proxy/native_rails.py guardrail-proxy/retrieval_rails.py guardrail-proxy/policy_bundle.py guardrail-proxy/policy_store.py guardrail-proxy/policy_cases.py /app/
COPY --chmod=0444 guardrail-proxy/policy.yaml /app/policy.yaml
COPY --chmod=0444 guardrail-proxy/nemo-policy/config.yml guardrail-proxy/nemo-policy/prompts.yml guardrail-proxy/nemo-policy/flows.co /app/nemo-policy/
COPY --chmod=0444 guardrail-proxy/ui/index.html guardrail-proxy/ui/app.js guardrail-proxy/ui/styles.css /app/ui/
RUN chmod 0755 /app/nemo-policy /app/ui && mkdir /state && chown 65532:65532 /state

USER 65532:65532
EXPOSE 8000
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000", "--log-level", "warning"]
