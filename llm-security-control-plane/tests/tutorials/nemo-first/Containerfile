FROM docker.io/library/python:3.12.14-slim
ENV NEMO_GUARDRAILS_NO_USAGE_STATS=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 XDG_CACHE_HOME=/opt/nemo-cache
RUN apt-get update \
    && apt-get install -y --no-install-recommends g++ \
    && python -m pip install nemoguardrails==0.22.0 langchain-openai==0.3.35 \
    && python -c "from fastembed import TextEmbedding; list(TextEmbedding(model_name='sentence-transformers/all-MiniLM-L6-v2', cache_dir='/opt/nemo-cache').embed(['cache warmup']))" \
    && chmod -R a+rX /opt/nemo-cache \
    && apt-get purge -y --auto-remove g++ \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /work
COPY --chmod=0555 config /work/config
COPY --chmod=0444 demo.py /work/demo.py
USER 65532:65532
ENTRYPOINT ["python", "/work/demo.py"]
