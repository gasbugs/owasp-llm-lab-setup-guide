{
  "rest": {
    "RestGenerator": {
      "name": "llm-security-application-gateway",
      "uri": "http://llm-security-application-gateway:8000/api/chat",
      "method": "post",
      "headers": {
        "Authorization": "Bearer hub-public-reader-token",
        "Content-Type": "application/json"
      },
      "req_template_json_object": {
        "message": "$INPUT",
        "classification": "none",
        "purpose": "public_information"
      },
      "response_json": true,
      "response_json_field": "reply",
      "request_timeout": 360,
      "ratelimit_codes": [429]
    }
  }
}
