FROM docker.io/library/python:3.12.14-slim

ENV AWS_EC2_METADATA_DISABLED=true \
    HOME=/tmp \
    PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1

COPY guided-bedrock-gateway/requirements.txt /tmp/requirements.txt
RUN python -m pip install --requirement /tmp/requirements.txt

WORKDIR /app
COPY --chmod=0444 guided-bedrock-gateway/h03_backend.py /app/h03_backend.py
COPY --chmod=0444 guided-bedrock-gateway/h04_backend.py /app/h04_backend.py
COPY --chmod=0444 guided-bedrock-gateway/h07_backend.py /app/h07_backend.py
COPY --chmod=0444 guided-bedrock-gateway/h08_backend.py /app/h08_backend.py
COPY --chmod=0444 guided-bedrock-gateway/p12_gateway.py guided-bedrock-gateway/p12_capabilities.py /app/
COPY --chmod=0444 guided-bedrock-gateway/p02_api.py guided-bedrock-gateway/p02_ledger.py guided-bedrock-gateway/p02_provider.py guided-bedrock-gateway/p02_contract.py guided-bedrock-gateway/p02_gateway.py /app/
COPY --chmod=0444 guided-bedrock-gateway/p02_resources.py /app/
COPY --chmod=0444 guided-bedrock-gateway/p02_reuse.py /app/
COPY --chmod=0444 guided-bedrock-gateway/p03_api.py guided-bedrock-gateway/p03_ledger.py guided-bedrock-gateway/p03_provider.py guided-bedrock-gateway/p03_backend.py guided-bedrock-gateway/p03_suites.py guided-bedrock-gateway/p03_gateway.py /app/
COPY --chmod=0444 guided-bedrock-gateway/p03_preparation.py guided-bedrock-gateway/p03_resource_contract.py guided-bedrock-gateway/p03_create_resources.py guided-bedrock-gateway/p03_seed_document.py guided-bedrock-gateway/p03_aws_preparation.py /app/
COPY --chmod=0444 guided-labs/h03-ingestion-search/cases.py /app/p03_cases.py
COPY --chmod=0444 guided-bedrock-gateway/p04_api.py guided-bedrock-gateway/p04_contract.py guided-bedrock-gateway/p04_ledger.py guided-bedrock-gateway/p04_invocation.py guided-bedrock-gateway/p04_backend.py guided-bedrock-gateway/p04_fixture_backend.py guided-bedrock-gateway/p04_suites.py guided-bedrock-gateway/p04_gateway.py /app/
COPY --chmod=0444 guided-labs/h04-bedrock-guardrail/cases.py /app/p04_cases.py
COPY --chmod=0444 guided-bedrock-gateway/p04_resource_contract.py guided-bedrock-gateway/p04_preparation.py guided-bedrock-gateway/p04_provisioning.py /app/
COPY --chmod=0444 guided-bedrock-gateway/p04_policy_audit.py /app/
COPY --chmod=0444 guided-bedrock-gateway/server.py /app/server.py
RUN install -d -o 65532 -g 65532 -m 0700 /state

USER 65532:65532
EXPOSE 8080
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8080", "--log-level", "warning"]
