FROM docker.io/library/python:3.12.14-slim

ENV AWS_EC2_METADATA_DISABLED=true \
    HOME=/tmp \
    PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1

COPY guided-bedrock-gateway/requirements.txt /tmp/requirements.txt
RUN python -m pip install --requirement /tmp/requirements.txt

WORKDIR /app
COPY --chmod=0444 guided-bedrock-gateway/server.py /app/server.py
RUN install -d -o 65532 -g 65532 -m 0700 /state

USER 65532:65532
EXPOSE 8080
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8080", "--log-level", "warning"]
