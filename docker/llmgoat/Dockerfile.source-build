# SECFORCE/LLMGoat v0.1.0 source-build fallback
# Upstream source: https://github.com/SECFORCE/LLMGoat/tree/v0.1.0
# Installation source fork: https://github.com/gasbugs/LLMGoat/tree/v0.1.0
# SPDX-License-Identifier: GPL-3.0-only

# 게시자 GPU image가 사라졌을 때만 NVIDIA 공식 CUDA image에서 로컬로 다시 만든다.
FROM nvidia/cuda:12.2.2-devel-ubuntu22.04@sha256:ae8a022c02aec945c4f8c52f65deaf535de7abb58e840350d19391ec683f4980

ARG VCS_REF=unknown
ARG APP_VERSION=dev
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    CUDA_ARCH=default \
    APP_VERSION=$APP_VERSION

LABEL org.opencontainers.image.title="OWASP LLMGoat local source build" \
      org.opencontainers.image.description="SECFORCE LLMGoat v0.1.0 rebuilt from the gasbugs source fork" \
      org.opencontainers.image.source="https://github.com/gasbugs/owasp-llm-lab-setup-guide" \
      org.opencontainers.image.revision="$VCS_REF" \
      org.opencontainers.image.version="$APP_VERSION" \
      org.opencontainers.image.licenses="GPL-3.0-only" \
      org.opencontainers.image.url="https://github.com/gasbugs/LLMGoat/tree/v0.1.0"

WORKDIR /app

ADD --checksum=sha256:4e3251ebd6ae59a4003791e18606a23ae94708bb48236caf51aa51cffbe34e29 \
    https://codeload.github.com/gasbugs/LLMGoat/tar.gz/refs/tags/v0.1.0 \
    /tmp/llmgoat-v0.1.0.tar.gz

# upstream GPU Dockerfile과 같은 CUDA compile 옵션·dependency 버전을 사용한다.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3.10 python3-pip python3.10-venv git build-essential \
        ninja-build cmake curl wget ccache \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /usr/src/llmgoat-v0.1.0 /usr/share/licenses/llmgoat \
    && tar -xzf /tmp/llmgoat-v0.1.0.tar.gz \
        --strip-components=1 -C /usr/src/llmgoat-v0.1.0 \
    && rm /tmp/llmgoat-v0.1.0.tar.gz \
    && python3.10 -m pip install --no-cache-dir --upgrade pip \
    && export LD_LIBRARY_PATH=/usr/local/cuda/lib64/stubs:$LD_LIBRARY_PATH \
    && ln -s /usr/local/cuda/lib64/stubs/libcuda.so \
        /usr/local/cuda/lib64/stubs/libcuda.so.1 \
    && CMAKE_ARGS="-DGGML_CUDA=on -DGGML_OPENMP=ON" \
        FORCE_CMAKE=1 NINJA_NUM_JOBS=$(nproc) \
        python3.10 -m pip install --no-cache-dir llama-cpp-python==0.3.16 \
    && rm /usr/local/cuda/lib64/stubs/libcuda.so.1 \
    && python3.10 -m pip uninstall -y torch torchvision torchaudio \
    && python3.10 -m pip install --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cpu \
        torch==2.8.0 torchvision torchaudio \
    && python3.10 -m pip install --no-cache-dir /usr/src/llmgoat-v0.1.0 \
    && cp /usr/src/llmgoat-v0.1.0/LICENSE /app/LICENSE \
    && cp /usr/src/llmgoat-v0.1.0/LICENSE \
        /usr/share/licenses/llmgoat/GPL-3.0.txt

COPY NOTICE.md /usr/share/doc/llmgoat/NOTICE.md
COPY COPYING /usr/share/licenses/llmgoat-wrapper/GPL-3.0-only.txt
COPY proxy_entrypoint.py /opt/owasp-llm/proxy_entrypoint.py

EXPOSE 5000
ENTRYPOINT ["python3", "/opt/owasp-llm/proxy_entrypoint.py"]
