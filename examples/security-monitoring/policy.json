{
  "version": "2026-08-14-safe-v1",
  "mode": "enforce",
  "prompt_injection": {
    "enabled": true,
    "risk_threshold": 0.6,
    "action": "block",
    "benign_event_types": ["security_training_quote"]
  },
  "sensitive_data": {
    "enabled": true,
    "entities": ["EMAIL_ADDRESS", "PHONE_NUMBER", "CREDIT_CARD", "KR_RRN", "DEMO_API_KEY"],
    "action": "redact"
  },
  "rag_tenant_boundary": {
    "enabled": true,
    "action": "block"
  },
  "agent_approval": {
    "enabled": true,
    "dangerous_tools": ["delete_animal", "debug_sql", "send_message"],
    "action": "block"
  },
  "request_limit": {
    "enabled": true,
    "window_seconds": 60,
    "max_requests_per_window": 5,
    "action": "block"
  }
}
