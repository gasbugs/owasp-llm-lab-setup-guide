logging {
  level  = "info"
  format = "logfmt"
}

// The application sends structured security logs and trace spans over OTLP.
// Alloy does not receive the Podman API socket; the observed application
// explicitly chooses which security events cross this telemetry boundary.
// Memory limiting and batching happen before independent Loki and Tempo exports.
otelcol.receiver.otlp "application" {
  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    logs   = [otelcol.processor.memory_limiter.application.input]
    traces = [otelcol.processor.memory_limiter.application.input]
  }
}

otelcol.processor.memory_limiter "application" {
  check_interval = "1s"
  limit          = "256MiB"

  output {
    logs   = [otelcol.processor.batch.application.input]
    traces = [otelcol.processor.batch.application.input]
  }
}

otelcol.processor.batch "application" {
  timeout             = "1s"
  send_batch_size     = 256
  send_batch_max_size = 512

  output {
    logs   = [otelcol.exporter.otlphttp.loki.input]
    traces = [otelcol.exporter.otlphttp.tempo.input]
  }
}

otelcol.exporter.otlphttp "loki" {
  logs_endpoint = "http://loki:3100/otlp/v1/logs"

  client {
    endpoint = "http://loki:3100/otlp"
  }

  sending_queue {
    enabled       = true
    num_consumers = 2
    queue_size    = 2048
  }

  retry_on_failure {
    enabled          = true
    initial_interval = "1s"
    max_interval     = "30s"
    max_elapsed_time = "5m"
  }
}

otelcol.exporter.otlphttp "tempo" {
  traces_endpoint = "http://tempo:4318/v1/traces"

  client {
    endpoint = "http://tempo:4318"
  }

  sending_queue {
    enabled       = true
    num_consumers = 2
    queue_size    = 2048
  }

  retry_on_failure {
    enabled          = true
    initial_interval = "1s"
    max_interval     = "30s"
    max_elapsed_time = "5m"
  }
}
