    },
    {
      "type": "stat",
      "title": "Blocked requests",
      "datasource": {"type": "prometheus", "uid": "llm-security-prometheus"},
      "targets": [{"expr": "sum(llm_security_decisions_total{decision=\"block\"})", "refId": "A"}],
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0}
    },
    {
      "type": "stat",
      "title": "Redacted responses",
      "datasource": {"type": "prometheus", "uid": "llm-security-prometheus"},
      "targets": [{"expr": "sum(llm_security_decisions_total{decision=\"redact\"})", "refId": "A"}],
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "Decisions by policy rule",
