FROM python:3.12-slim

# Presidio Analyzer와 Anonymizer를 같은 검증 버전으로 고정한다.
ARG PRESIDIO_VERSION=2.2.362

# Python 로그를 즉시 출력하고 package cache가 image layer에 남지 않게 한다.
# Presidio가 사용하는 외부 데이터 cache는 쓰기 가능한 전용 경로에 둔다.
ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    XDG_CACHE_HOME=/opt/presidio-cache

# Presidio, HTTP API와 NeMo 연동에 필요한 runtime만 설치한다.
# spaCy 영어 모델은 이메일·전화번호 탐지의 문맥 분석에 사용한다.
# vim-tiny는 수강생이 컨테이너 안의 secure_coding.py를 직접 확인·수정할 때 사용한다.
RUN python -m pip install \
      "presidio-analyzer==${PRESIDIO_VERSION}" \
      "presidio-anonymizer==${PRESIDIO_VERSION}" \
      "fastapi>=0.115,<1" \
      "uvicorn>=0.32,<1" \
      "httpx>=0.27,<1" \
    && python -m spacy download en_core_web_sm \
    && python -c "import tldextract; tldextract.extract('example.com')" \
    && apt-get update \
    && apt-get install -y --no-install-recommends vim-tiny \
    && rm -rf /var/lib/apt/lists/* \
    && chmod -R a+rwX /opt/presidio-cache

WORKDIR /app
# 정책 코어와 서버 파일은 읽기 전용으로 배포해 실습 기준 구현을 보호한다.
COPY --chmod=0444 presidio_core.py scan_pii.py server.py entrypoint.py /app/
# NodeGoat 방식으로 전환할 secure_coding.py만 비 root 사용자에게 쓰기를 허용한다.
COPY --chown=65532:65532 --chmod=0644 secure_coding.py /app/secure_coding.py
RUN chown 65532:65532 /app

# root 권한을 버리고 loopback publish 대상인 API port만 선언한다.
USER 65532:65532
EXPOSE 8013
# entrypoint는 CLI --suite/--case와 HTTP server mode를 하나의 image에서 선택한다.
ENTRYPOINT ["python", "/app/entrypoint.py"]
