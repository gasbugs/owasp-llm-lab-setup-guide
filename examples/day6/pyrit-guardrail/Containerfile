# PyRIT 1.0.1 실행만 포함하는 WSL용 격리 이미지다.
FROM python:3.12.11-slim-bookworm

ARG PYRIT_VERSION=1.0.1

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HOME=/tmp

RUN python -m pip install "pyrit==${PYRIT_VERSION}"

WORKDIR /work
COPY --chown=65532:65532 attack.py /work/attack.py
COPY --chown=65532:65532 report.py /work/report.py

USER 65532:65532
ENTRYPOINT ["python", "/work/attack.py"]
